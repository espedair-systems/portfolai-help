---
const { title = 'Summary' } = Astro.props;
---
<div class="summary-card p-6 my-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50 shadow-sm">
  <h4 class="text-lg font-semibold mb-2 text-slate-900 dark:text-slate-100">{title}</h4>
  <div class="text-slate-600 dark:text-slate-300">
    <slot />
  </div>
</div>
